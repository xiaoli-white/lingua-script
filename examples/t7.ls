let x be ten.
let y be five.
let z be x added to y.
say z.
let w be x subtracted from y.
say w.
let v be x multiplied by y.
say v.
let u be x divided by y.
say u.
when x is greater than y:
    say "x > y".
otherwise:
    say "x <= y".
end.
let count be zero.
repeat five times:
    count becomes count added to one.
end.
say count.
